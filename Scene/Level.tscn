[sub_resource type="Shader" id="Shader_p43b4"]
code = "shader_type sky;

uniform sampler2D source_panorama : filter_linear, source_color, hint_default_black;
uniform float exposure : hint_range(0, 128) = 15.0;
uniform float speed = 0.02;
uniform float saturation = 1.0;
uniform float tone_mapping_strength : hint_range(0.1, 1.0) = 0.35; // Baru: Dibuat uniform untuk kontrol mudah

void sky() {
    // Pastikan koordinat X dibungkus (wrap) dengan mod(..., 1.0) untuk loop animasi yang mulus
    vec2 skyCoords = vec2(mod(SKY_COORDS.x + TIME * speed, 1.0), SKY_COORDS.y);
    vec3 hdrColor = texture(source_panorama, skyCoords).rgb * exposure;

    // --- Perbaikan Warna Ungu (Modifikasi) ---
    vec3 adjustedColor = hdrColor;

    // 1. Kurangi Red (R) lebih banyak, karena Ungu = Merah + Biru
    adjustedColor.r *= 0.85; // Turunkan dari 0.9

    // 2. Tambah Green (G) sedikit untuk menggeser corak ke arah Cyan/Langit alami
    adjustedColor.g *= 1.05;

    // 3. Biru (B) dibiarkan 1.0 atau disesuaikan jika perlu
    adjustedColor.b *= 1.0;

    // --- Tone Mapping ---
    // Menggunakan uniform tone_mapping_strength untuk kontrol nilai 0.4 sebelumnya
    vec3 mapped = 1.0 - exp(-adjustedColor * tone_mapping_strength);

    // --- Saturasi ---
    float luminance = dot(mapped, vec3(0.2126, 0.7152, 0.0722));
    mapped = mix(vec3(luminance), mapped, saturation);

    COLOR = mapped;
}"

